# Salin ke .env.local untuk lokal. Di Vercel, isi lewat Project Settings → Environment Variables.

# Database. Kosongkan untuk memakai PGlite (Postgres lokal di folder .data/pglite, tanpa instalasi).
# Untuk Vercel: connection string Postgres dari Neon atau Supabase (pakai URL "pooled").
DATABASE_URL=

# Rahasia endpoint cron (header Authorization: Bearer <CRON_SECRET>). Isi string acak yang panjang.
CRON_SECRET=

# Email via Resend. Di lokal boleh kosong: email ditampung di http://localhost:3000/dev/email.
RESEND_API_KEY=
EMAIL_FROM="PantauPangan <onboarding@resend.dev>"

# URL publik situs (tautan di email, User-Agent ke sumber data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sumber data: pihps (PIHPS Bank Indonesia) | mock (data contoh, tanpa jaringan)
DATA_SOURCE=pihps

# Opsional: email developer yang diberi tahu jika pengambilan data gagal 2 run berturut-turut.
ALERT_DEV_EMAIL=

# Hanya untuk fitur ringkasan mingguan AI (P1, belum diimplementasikan).
ANTHROPIC_API_KEY=
